# Example: create a local PostgreSQL database named balancevault and either use
# the default postgres role or create a dedicated role such as app_user.
# Update the username/password below to match your local PostgreSQL setup.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/balancevault?schema=public"
# Local dev can use the same URL above; production should use a dedicated migration role.
MIGRATION_DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/balancevault?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
WEB_ORIGIN="http://localhost:5173"
PORT=4000
# Optional for local development; required in production.
REDIS_URL=
# Only for the one-time bootstrap command. Remove after use.
ADMIN_EMAIL="admin@example.test"
ADMIN_NAME="Demo Administrator"
ADMIN_PASSWORD="replace-with-a-random-password-of-16-characters"
